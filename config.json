{
  "provider": "gemini",
  "model": "gemini-3.1-flash-lite",
  "base_url": "https://generativelanguage.googleapis.com/v1beta",
  "api_key_env": "GEMINI_API_KEY",
  "episodes_per_minute": 2,
  "temperature": null,
  "max_output_tokens": 8192,
  "use_json_mode": true,
  "timeout_seconds": 120,
  "max_429_retries": 4,
  "max_retry_wait_seconds": 300,
  "snap_tolerance_seconds": 0.25,
  "cache_dir": ".cache/llm",
  "raw_outputs_dir": "raw_outputs"
}
