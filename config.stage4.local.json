{
  "provider": "ollama_local",
  "model": "qwen3:4b-instruct",
  "base_url": "http://127.0.0.1:11434",
  "api_key_env": null,
  "episodes_per_minute": 60,
  "temperature": 0.7,
  "max_output_tokens": 3072,
  "context_tokens": 16384,
  "max_candidates_per_episode": 2,
  "judge_batch_size": 2,
  "use_json_mode": true,
  "timeout_seconds": 1800,
  "max_429_retries": 4,
  "max_retry_wait_seconds": 300,
  "snap_tolerance_seconds": 0.25,
  "cache_dir": ".cache/llm",
  "raw_outputs_dir": "raw_outputs",
  "cross_episode_batch_size": 10,
  "max_cross_options": 10,
  "max_consecutive_failures": 3,
  "dedup_iou_threshold": 0.6,
  "same_episode_penalty": 3.0,
  "same_five_episode_block_penalty": 1.0,
  "same_character_penalty": 1.0,
  "scoring_weights": {
    "hook_strength": 0.17,
    "cliffhanger_strength": 0.2,
    "standalone_clarity": 0.15,
    "emotional_intensity": 0.07,
    "genre_fit": 0.05,
    "spoiler_avoidance": 0.06,
    "speech_opening": 0.08,
    "dialogue_density": 0.06,
    "length_sweet_spot": 0.1,
    "early_episode": 0.06
  }
}
